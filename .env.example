# Copy to .env and fill in. Never commit real values.

# Persistent directory for the SQLite database. Default /data (the container volume).
DATA_DIR=./data

# Worker: milliseconds to wait on SIGTERM for the current job to be released. Default 4000.
WORKER_SHUTDOWN_TIMEOUT_MS=4000

# LLM for casting and adaptation: any OpenAI-compatible Chat Completions endpoint with JSON-schema
# structured output. Without LLM_API_KEY, no paid LLM call can be made. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=90000

# Local audio service (services/local-audio): where it listens (loopback only), an optional access token,
# the per-render timeout, the render speed for the pre-render estimate (118 ms per character measured on an
# Apple M2; measure your own machine and set it here), and the seed sent with every render.
LOCAL_AUDIO_URL=http://127.0.0.1:8765
LOCAL_AUDIO_TOKEN=
LOCAL_AUDIO_TIMEOUT_MS=600000
LOCAL_AUDIO_MS_PER_CHAR=118
TTS_SEED=0

# Global daily caps (UTC day). Missing or 0 disables that kind of paid call; demo playback still works.
GLOBAL_DAILY_TTS_CHAR_LIMIT=0
GLOBAL_DAILY_LLM_TOKEN_LIMIT=0

# Operator ceiling for any single Book's TTS budget (a user-chosen budget cannot exceed it). Default 60000.
BOOK_TTS_CHAR_LIMIT=60000

# Optional judge passkey gating all custom generation (sent in the x-midnight-passkey header).
UPLOAD_PASSKEY=
