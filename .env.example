# Copy to .env and fill in. Never commit real values.

# Persistent directory for the SQLite database, render cache, uploads and published episodes (broadcast/).
# Default /data (the container volume). A relative path is taken from the repository root.
DATA_DIR=./data

# Worker: milliseconds to wait on SIGTERM for the current job to be released. Default 4000.
WORKER_SHUTDOWN_TIMEOUT_MS=4000
# Generation (upload, casting, adaptation, rendering): "true" only where the generation flow runs (it needs the LLM and a speech server).
# Off by default, and always off on the live site, where only the pre-rendered demos play.
GENERATION_ENABLED=false
# "true" generates with an offline stand-in model and tone voices: for tests and for trying the flow without a
# key or the audio models. What it makes is not a real adaptation.
MIDNIGHT_STUB_PROVIDERS=false

# LLM for casting and adaptation: any OpenAI-compatible Chat Completions endpoint with JSON-schema
# structured output. Without LLM_API_KEY, no paid LLM call can be made. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=90000

# Speech server (docs/tts-service-api.md): services/local-audio on this machine (http://127.0.0.1:8765), or the
# Kaggle server (services/local-audio/kaggle) through its https tunnel. Plain http only on loopback; any other
# host needs https and a token of at least 16 characters. Also the per-render timeout, the render speed for
# the pre-render estimate (118 ms per character measured on an Apple M2; the Kaggle bench prints yours), and
# the seed sent with every render. The catalogue pins the speech build: see assets/voices/catalogue.json.
LOCAL_AUDIO_URL=http://127.0.0.1:8765
LOCAL_AUDIO_TOKEN=
LOCAL_AUDIO_TIMEOUT_MS=600000
LOCAL_AUDIO_MS_PER_CHAR=118
TTS_SEED=0
# Sound-effect service (offline foley generation only, see docs/sfx-service-api.md). Plain http is accepted
# only on loopback; any other host needs https and a token of at least 16 characters. Never used at runtime.
SFX_SERVICE_URL=http://127.0.0.1:8765
SFX_SERVICE_TOKEN=
SFX_SERVICE_TIMEOUT_MS=900000

# Global daily caps (UTC day): TTS characters rendered locally, and LLM tokens (paid API calls). Missing or 0
# disables that kind of call; demo playback still works.
GLOBAL_DAILY_TTS_CHAR_LIMIT=0
GLOBAL_DAILY_LLM_TOKEN_LIMIT=0

# Operator ceiling for any single Book's TTS budget (a user-chosen budget cannot exceed it). Default 60000.
BOOK_TTS_CHAR_LIMIT=60000

# Optional judge passkey gating all custom generation (sent in the x-midnight-passkey header).
UPLOAD_PASSKEY=
# The header your host sets to the client's address, for rate limits (e.g. fly-client-ip). Never x-forwarded-for.
# Unset: every client shares one limit, which is safe but strict.
CLIENT_IP_HEADER=
